FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/registry.k8s.io/kubectl:v1.32.7 AS kubectl

FROM python:3.13-alpine

COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl

WORKDIR /app
COPY deploy/cce/release.py /app/release.py
COPY deploy/cce/codearts/slot_release.py /app/slot_release.py

RUN addgroup -g 65532 release \
    && adduser -D -H -u 65532 -G release release \
    && chmod 0555 /app/release.py /app/slot_release.py

USER 65532:65532
ENTRYPOINT ["python3", "/app/slot_release.py"]
