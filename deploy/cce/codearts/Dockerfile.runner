FROM python:3.13-alpine

ARG KUBECTL_VERSION=v1.32.9
ARG KUBECTL_SHA256=509ae171bac7ad3b98cc49f5594d6bc84900cf6860f155968d1059fde3be5286

RUN for attempt in 1 2 3 4 5; do \
      wget -q -O /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && break; \
      test "$attempt" = 5 && exit 1; \
      sleep $((attempt * 3)); \
    done \
    && echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/kubectl

WORKDIR /app
COPY deploy/cce/release.py /app/release.py
COPY deploy/cce/codearts/slot_release.py /app/slot_release.py

RUN addgroup -g 65532 release \
    && adduser -D -H -u 65532 -G release release \
    && chmod 0555 /app/release.py /app/slot_release.py

USER 65532:65532
ENTRYPOINT ["python3", "/app/slot_release.py"]
